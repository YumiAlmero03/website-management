# ContentHub AI — Environment Configuration Template
# Copy to .env (chmod 600) and replace every CHANGE_ME value before starting.
# Never commit .env, real credentials, or backups to Git.

# ==============================================================================
# Application
# ==============================================================================
APP_NAME="ContentHub AI"
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://127.0.0.1:3100
API_BASE_URL=http://127.0.0.1:8100
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8100
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# ==============================================================================
# Security & Encryption
# Generate strong random values and keep APP_ENCRYPTION_KEY outside the database.
#   APP_SECRET_KEY:     python3 -c "import secrets; print(secrets.token_hex(32))"
#   APP_ENCRYPTION_KEY: python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ==============================================================================
APP_SECRET_KEY=CHANGE_ME_GENERATE_64_HEX_CHAR_SECRET
APP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_VALID_FERNET_KEY
SESSION_COOKIE_NAME=contenthub_session
SESSION_TTL_MINUTES=720
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ==============================================================================
# Existing aaPanel MySQL Database
# Never use the MySQL root user at runtime. Create a dedicated least-privilege user.
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=contenthub_ai
DB_USER=contenthub_user
DB_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5

# Optional isolated MySQL URL for running live DB integration tests (`pytest -m mysql`).
# NEVER point this at a production database.
CONTENTHUB_TEST_DATABASE_URL=

# ==============================================================================
# Persistent Storage
# Keep outside the replaceable application directory in production (e.g. /www/contenthub-storage).
# ==============================================================================
STORAGE_ROOT=./storage

# ==============================================================================
# Resource Guardian Initial Defaults (monitored via psutil)
# ==============================================================================
RESOURCE_CPU_WARNING_PERCENT=65
RESOURCE_CPU_CRITICAL_PERCENT=85
RESOURCE_RAM_WARNING_PERCENT=75
RESOURCE_LOAD_AVG_THRESHOLD=12.0
RESOURCE_MAX_CONCURRENT_GENERATION=1
RESOURCE_MAX_CONCURRENT_BROWSERS=1
RESOURCE_RECHECK_INTERVAL_MINUTES=5

# ==============================================================================
# Phase 2 & 2.1 — Website Scanner, SSRF Security, Content Extraction & Media
# ==============================================================================
SCANNER_USER_AGENT="ContentHubAI/0.2.1 (+self-hosted-website-monitor)"
SCANNER_REQUEST_TIMEOUT_SECONDS=15
SCANNER_CRAWL_DELAY_SECONDS=0.5
SCANNER_MAX_URLS_PER_SCAN=20000
SCANNER_MAX_DISCOVERY_URLS=20000
SCANNER_DEFAULT_CRAWL_BATCH_SIZE=100
SCANNER_DEFAULT_CRAWL_MAX_URLS_PER_RUN=1000
SCANNER_MAX_RESPONSE_BYTES=5242880
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_SITEMAP_DEPTH=4
SCANNER_MAX_SITEMAP_FILES=100
SCANNER_MAX_DECOMPRESSED_BYTES=20971520
SCANNER_RESPECT_ROBOTS_TXT=true
SCANNER_ENABLE_PLAYWRIGHT=false
SCANNER_STALE_TIMEOUT_MINUTES=30
SCANNER_MAX_RETRIES=2
# Comma-separated trusted internal hostnames explicitly permitted past SSRF private-IP blocks
SCANNER_TRUSTED_INTERNAL_HOSTS=

CONTENT_MAX_CONTEXT_CHARS=4000
CONTENT_MAX_KEYWORDS=12
CONTENT_NEAR_DUPLICATE_THRESHOLD=88.0

# Media handling: url_only (default) or local (downloads validated article images to STORAGE_ROOT/images)
MEDIA_STORAGE_MODE=url_only
MEDIA_MAX_FILE_BYTES=5242880
MEDIA_MAX_DIMENSION_PX=4096
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=15

# ==============================================================================
# Frontend Runtime Proxy (Nuxt -> FastAPI)
# ==============================================================================
NUXT_API_PROXY_TARGET=http://127.0.0.1:8100
NUXT_PUBLIC_APP_NAME="ContentHub AI"
NUXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Manila

# Phase 3 — Gemini AI Engine (Free-First) & Background Job Settings
# Leave GEMINI_API_KEY blank if storing Fernet-encrypted keys via UI AI Management instead.
GEMINI_API_KEY=
AI_DEFAULT_MODEL=gemini-3.5-flash-lite
AI_DEFAULT_TEMPERATURE=0.4
AI_DEFAULT_MAX_OUTPUT_TOKENS=1500
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRY_ATTEMPTS=2
AI_CACHE_TTL_DAYS=30
AI_JOB_STALE_TIMEOUT_MINUTES=15
AI_JOB_MAX_ATTEMPTS=3

# ==============================================================================
# AI Generation Note (Phase 3+)
# Google Gemini API is the sole AI generation provider (keys managed encrypted
# in MySQL via Phase 3 AI Management). Native Python handles extraction,
# summarization, keyword extraction, and token optimization.
# No Docker or external AI agent framework environment variables are required.
# ==============================================================================
