# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Python / Backend
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node / Nuxt Frontend
frontend/node_modules/
frontend/.nuxt/
frontend/.output/
frontend/.nitro/
frontend/.cache/
frontend/.data/
frontend/dist/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Persistent runtime storage (preserve directory markers only)
storage/images/*
!storage/images/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/backups/*
!storage/backups/.gitkeep
storage/logs/*
!storage/logs/.gitkeep

# Database dumps & backups
*.sql
*.sql.gz
*.dump
*.bak
*.sqlite
*.sqlite3
*.db
